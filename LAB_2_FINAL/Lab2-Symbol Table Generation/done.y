     | func_definition
     {
		outlog<<"At line no: "<<lines<<" unit : func_definition "<<endl<<endl;
		outlog<<$1->get_name()<<endl<<endl;
		
		$$ = new symbol_info($1->get_name(),"unit");
	 }
     ;

/*
 * func_definition uses an INLINE mid-rule action between RPAREN and compound_statement.
 * This mid-rule action inserts the function into the symbol table BEFORE
 * the compound_statement creates a new scope.
 * We use $1->get_name() for return type (not current_type which gets overwritten by param types).
 * The mid-rule action takes up a $N position, shifting compound_statement to $7 or $6.
 */
func_definition : type_specifier ID LPAREN param_list RPAREN 
		{
			// --- mid-rule action: insert function into current (parent) scope ---
			// $1 = type_specifier, $2 = ID
			symbol_info *func_symbol = new symbol_info($2->get_name(), "ID");
			func_symbol->set_symbol_kind("function");
			func_symbol->set_data_type($1->get_name());  // use $1, NOT current_type
			func_symbol->set_func_no_of_parameters(param_types.size());
			func_symbol->set_func_parameter_types(param_types);
			func_symbol->set_func_parameter_names(param_names);
			symb_table->insert(func_symbol);
		}
		compound_statement
		{	
			// $7 = compound_statement (mid-rule action took $6)
			outlog<<"At line no: "<<lines<<" func_definition : type_specifier ID LPAREN param_list RPAREN compound_statement "<<endl<<endl;
			outlog<<$1->get_name()<<" "<<$2->get_name()<<"("+$4->get_name()+")\n"<<$7->get_name()<<endl<<endl;
			
			$$ = new symbol_info($1->get_name()+" "+$2->get_name()+"("+$4->get_name()+")\n"+$7->get_name(),"func_def");	
		}
		| type_specifier ID LPAREN RPAREN 
		{
			// --- mid-rule action: insert function with no params ---
			symbol_info *func_symbol = new symbol_info($2->get_name(), "ID");
			func_symbol->set_symbol_kind("function");
			func_symbol->set_data_type($1->get_name());
			func_symbol->set_func_no_of_parameters(0);
			vector<string> empty_types;
			vector<string> empty_names;
			func_symbol->set_func_parameter_types(empty_types);
			func_symbol->set_func_parameter_names(empty_names);
			symb_table->insert(func_symbol);
		}
		compound_statement
		{
			// $6 = compound_statement (mid-rule action took $5)
			outlog<<"At line no: "<<lines<<" func_definition : type_specifier ID LPAREN RPAREN compound_statement "<<endl<<endl;
			outlog<<$1->get_name()<<" "<<$2->get_name()<<"()\n"<<$6->get_name()<<endl<<endl;
			
			$$ = new symbol_info($1->get_name()+" "+$2->get_name()+"()\n"+$6->get_name(),"func_def");	
		}
 		;

param_list : param_list COMMA type_specifier ID
		{
			outlog<<"At line no: "<<lines<<" param_list : param_list COMMA type_specifier ID "<<endl<<endl;
			outlog<<$1->get_name()<<","<<$3->get_name()<<" "<<$4->get_name()<<endl<<endl;
					
			$$ = new symbol_info($1->get_name()+","+$3->get_name()+" "+$4->get_name(),"param_list");
			
			param_types.push_back($3->get_name());
			param_names.push_back($4->get_name());
		}
		| param_list COMMA type_specifier
		{
			outlog<<"At line no: "<<lines<<" param_list : param_list COMMA type_specifier "<<endl<<endl;
			outlog<<$1->get_name()<<","<<$3->get_name()<<endl<<endl;
			
			$$ = new symbol_info($1->get_name()+","+$3->get_name(),"param_list");
		}
 		| type_specifier ID
 		{
			outlog<<"At line no: "<<lines<<" param_list : type_specifier ID "<<endl<<endl;
			outlog<<$1->get_name()<<" "<<$2->get_name()<<endl<<endl;
			
			$$ = new symbol_info($1->get_name()+" "+$2->get_name(),"param_list");
			
			// first parameter: clear old data and start fresh
			param_types.clear();
			param_names.clear();
			param_types.push_back($1->get_name());
			param_names.push_back($2->get_name());
		}
		| type_specifier
		{
			outlog<<"At line no: "<<lines<<" param_list : type_specifier "<<endl<<endl;
			outlog<<$1->get_name()<<endl<<endl;
			
			$$ = new symbol_info($1->get_name(),"param_list");
			
			// type-only param (no name), just clear
			param_types.clear();
			param_names.clear();
		}
 		;

/*
 * compound_statement uses the enter_scope MARKER after LCURL.
 * Exit logic (print all scopes + exit scope) is done in the MAIN action
 * so it runs AFTER the compound_statement log is printed (correct order).
 */
compound_statement : LCURL enter_scope statements RCURL
			{ 
 		    	outlog<<"At line no: "<<lines<<" compound_statement : LCURL statements RCURL "<<endl<<endl;
				outlog<<"{\n"+$3->get_name()+"\n}"<<endl<<endl;
				
				$$ = new symbol_info("{\n"+$3->get_name()+"\n}","comp_stmnt");
				
				// print all scopes, then exit the current scope
				symb_table->print_all_scopes(outlog);
				int removed_id = symb_table->get_current_scope_id();
				symb_table->exit_scope();
				outlog << "Scopetable with ID " << removed_id << " removed" << endl << endl;
 		    }
 		    | LCURL enter_scope RCURL
 		    { 
 		    	outlog<<"At line no: "<<lines<<" compound_statement : LCURL RCURL "<<endl<<endl;
				outlog<<"{\n}"<<endl<<endl;
				
				$$ = new symbol_info("{\n}","comp_stmnt");
				
				symb_table->print_all_scopes(outlog);
				int removed_id = symb_table->get_current_scope_id();
				symb_table->exit_scope();
				outlog << "Scopetable with ID " << removed_id << " removed" << endl << endl;
 		    }
 		    ;

/*
 * Marker non-terminal: enter_scope
 * Runs right after LCURL is consumed.
 * Creates a new scope and inserts any pending function parameters.
 */
enter_scope :
	{
		symb_table->enter_scope();
		outlog << "New ScopeTable with ID " << symb_table->get_current_scope_id() << " created" << endl << endl;

		// if there are function parameters waiting, insert them into this new scope
		for (int i = 0; i < (int)param_types.size(); i++)
		{
			symbol_info *param = new symbol_info(param_names[i], "ID");
			param->set_symbol_kind("variable");
			param->set_data_type(param_types[i]);
			symb_table->insert(param);
		}
		// clear so they dont get inserted again
		param_types.clear();
		param_names.clear();
	}
	;

 		    
variable_decl : type_specifier declaration_list SEMICOLON
		 {
			outlog<<"At line no: "<<lines<<" variable_decl : type_specifier declaration_list SEMICOLON "<<endl<<endl;
			outlog<<$1->get_name()<<" "<<$2->get_name()<<";"<<endl<<endl;
			
			$$ = new symbol_info($1->get_name()+" "+$2->get_name()+";","var_dec");
			
			// insert all the declared variables into symbol table
			for (int i = 0; i < (int)var_names.size(); i++)
			{
				symbol_info *var = new symbol_info(var_names[i], "ID");
				var->set_data_type(current_type);

				if (var_arr_sizes[i] > 0)
				{
					var->set_symbol_kind("array");
					var->set_arr_size(var_arr_sizes[i]);
				}
				else
				{
					var->set_symbol_kind("variable");
				}

				symb_table->insert(var);
			}

			var_names.clear();
			var_arr_sizes.clear();
		 }
 		 ;

